ffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="G3" target="IZ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Amount ≥ порога&lt;br&gt;209" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1c5fb0;fontColor=#1c5fb0;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="G3" target="DS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="209" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="DS" target="IZ"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1695" y="40"/></Array></mxGeometry></mxCell><mxCell id="e10" value="911" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="IZ" target="VY"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="reject 45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="G1" target="OT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="reject 18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="G2" target="OT"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="40"/></Array></mxGeometry></mxCell><mxCell id="e13" value="cancel 26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="G2" target="OM"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="40"/></Array></mxGeometry></mxCell><mxCell id="e14" value="return 174" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b8860b;fontColor=#b8860b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="G2" target="DR"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="415"/></Array></mxGeometry></mxCell><mxCell id="e15" value="174" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b8860b;fontColor=#b8860b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="DR" target="PP"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="415"/></Array></mxGeometry></mxCell><mxCell id="leg" value="&lt;b&gt;Легенда.&lt;/b&gt;&lt;br&gt;Прямоугольник — задание, выполняемое человеком (в скобках роль).&lt;br&gt;Овал — автоматическое событие: начало и окончания экземпляра (system).&lt;br&gt;Ромб — развилка, выведенная по данным; в журнале шлюзов нет, это реконструкция.&lt;br&gt;Число на стрелке — сколько раз наблюдался переход (всего 1000 экземпляров). Надпись у выхода — значение Result.&lt;br&gt;Синяя стрелка — ветка по сумме (гипотеза порога); красная — завершение без исполнения; оранжевая — возврат на доработку.&lt;br&gt;Ограничение: схема не фиксирует, что отклонение на первичной проверке и отмена/отклонение руководителем в журнале только при первом проходе, а возвратов не больше двух подряд." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;strokeColor=#999999;fillColor=#ffffff;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="1100" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>